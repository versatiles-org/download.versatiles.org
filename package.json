{
  "name": "download.versatiles.org",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/versatiles-org/download.versatiles.org.git"
  },
  "scripts": {
    "build:site": "npm run prebuild:site && vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:e2e && cd worker && npm run check",
    "dev": "tsx src/generate_testdata.ts && vite dev",
    "doc": "npm run doc-graph",
    "doc-graph": "vrt deps-graph | vrt doc-insert README.md '## Dependency Graph'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "once": "tsx --env-file=.env src/run_once.ts",
    "prebuild:site": "test -f data/fileGroups.json || tsx src/generate_testdata.ts",
    "prepare": "svelte-kit sync",
    "preview:site": "vite preview",
    "setup": "bash scripts/setup.sh",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "upgrade": "ncu -u && npm install && cd worker && ncu -u && npm install && cd .."
  },
  "type": "module",
  "author": {
    "name": "Michael Kreil",
    "email": "github@michael-kreil.de",
    "url": "https://github.com/MichaelKreil"
  },
  "license": "MIT",
  "private": true,
  "overrides": {
    "cookie": "^0.7.0"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@versatiles/container": "^1.5.0",
    "@versatiles/svelte": "^2.3.1",
    "sass": "^1.102.0",
    "svelte": "^5.56.8",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@versatiles/release-tool": "^2.9.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "npm-check-updates": "^23.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.5"
  }
}
