{
  "name": "download.versatiles.org",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/versatiles-org/download.versatiles.org.git"
  },
  "scripts": {
    "build:site": "npm run prebuild:site && vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:e2e && cd worker && npm run check",
    "dev": "tsx src/generate_testdata.ts && vite dev",
    "doc": "npm run doc-graph",
    "doc-graph": "vrt deps-graph | vrt doc-insert README.md '## Dependency Graph'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "svelte-kit sync && eslint src/ e2e/",
    "lint:fix": "svelte-kit sync && eslint src/ e2e/ --fix",
    "once": "tsx --env-file-if-exists=.env src/run_once.ts",
    "prebuild:site": "test -f data/fileGroups.json || tsx src/generate_testdata.ts",
    "prepare": "svelte-kit sync",
    "preview:site": "vite preview",
    "setup": "bash scripts/setup.sh",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "upgrade": "vrt deps-upgrade && cd worker && ncu -u --peer && npm install && npm audit fix && cd .."
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "author": {
    "name": "Michael Kreil",
    "email": "github@michael-kreil.de",
    "url": "https://github.com/MichaelKreil"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@versatiles/container": "^2.0.2",
    "@versatiles/svelte": "^3.0.1",
    "sass": "^1.106.1",
    "svelte": "^5.57.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@versatiles/release-tool": "^2.20.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7"
  }
}
